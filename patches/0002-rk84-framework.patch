+/* Resolved keycode per physical position: captured on press and used
+ * on release so a layer change while a key is held cannot re-resolve
+ * the release to a different keycode (or KC_NO) and leave a stuck key.
+ * Held in xdata to spare internal RAM.
+ *
+ * OFF by default for upstream boards: the cache costs
+ * MATRIX_ROWS*MATRIX_COLS*2 bytes of XRAM and changes input behavior.
+ * Boards that want the sticky-key fix (e.g. RK84 via the meson board
+ * option) define SMK_ACTIVE_KEYCODE_CACHE=1 explicitly.
+ */
+#ifndef SMK_ACTIVE_KEYCODE_CACHE
+#define SMK_ACTIVE_KEYCODE_CACHE 0
+#endif
+
+#if SMK_ACTIVE_KEYCODE_CACHE
+static __xdata uint16_t active_keycode[MATRIX_ROWS][MATRIX_COLS];
+#endif
+
+static uint16_t resolve_keycode(uint8_t row, uint8_t col)
+{
+    uint16_t qcode = keymaps[0][row][col];
+
+    /*
+     * A base-layer momentary key must remain momentary even while
+     * another layer is active.
+     */
+    if (IS_QK_MOMENTARY(qcode)) {
+        return qcode;
+    }
+
+    if (action_layer) {
+        uint16_t layer_code = keymaps[action_layer][row][col];
+
+        if (layer_code != KC_TRANSPARENT) {
+            qcode = layer_code;
+        }
+    }
+
+#if SMK_DYNAMIC_KEYMAP
+    /* Configurator (M2): a validated runtime map overrides the
+     * compiled defaults when active. 0xFFFF means inactive/out of
+     * range -> keep the compiled resolution above. */
+    {
+        uint16_t dyn = dynamic_keymap_resolve(action_layer, row, col);
+        if (dyn != 0xFFFFu) {
+            qcode = dyn;
+        }
+    }
+#endif
+
+    return qcode;
+}
