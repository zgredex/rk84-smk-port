     ['example', 'sh68f90a', ['default'], {}],
     ['nuphy-air60', 'sh68f90a', ['default'], { 'vendor_id': '0x05ac', 'product_id': '0x024f', 'wireless': 'bk3632', 'led_rows': '5', 'led_cols': '16', 'led_cx2': '13', 'led_cy2': '4' }],
     ['eyooso-z11', 'sh68f90a', ['default'], { 'vendor_id': '0x258a', 'product_id': '0x002a', 'led_rows': '5', 'led_cols': '14', 'led_cx2': '13', 'led_cy2': '4' }],
+    # RK84 (SH68F90A): 16x6 matrix, 21x6 LED grid, wired milestone 1.
+    # Bring-up stage selected via -Drk84_stage=recovery|matrix|rgb;
+    # dual reports behind -Drk84_dual_reports=true (host-tested only).
+    ['royalkludge-rk84', 'sh68f90a', ['default'], {
+        'vendor_id': '0x258a',
+        'product_id': '0x0059',
+        'led_rows': '6',
+        'led_cols': '21',
+        'led_cx2': '21',
+        'led_cy2': '4',
+        'usb_bcd_device': '0x1025',
+        'usb_ep1_mps': '8',
+        'usb_ep2_mps': '16',
+        'usb_serial_index': '0',
+        'usb_manufacturer': '"SINO WEALTH"',
+        'usb_product': '"RK Bluetooth Keyboar"',
+        'usb_serial': '""',
+        'rk84_stock_reports': true,
+        'rk84_recovery_only': rk84_stage == 'recovery',
+        'rk84_rgb': rk84_stage == 'rgb',
+        # The final RGB image must RETAIN the proven USB-full runtime
+        # (config gate, suspend/resume, remote wake, resync, lock LEDs).
+        # usb and rgb are no longer mutually exclusive.
+        'rk84_usb_full': rk84_stage == 'usb' or rk84_stage == 'rgb',
+        'rk84_dual_reports': get_option('rk84_dual_reports'),
+        'rk84_active_keycode_cache': true,
+        'rk84_dynamic_keymap': get_option('rk84_dynamic_keymap'),
+    }],
 ]
 
 # SMK
@@ -94,7 +124,13 @@ possible_src_keyboard = [
     'user_matrix.c',
     'user_init.c',
     # 'user_keyboard.c',
-    'kb.c'
+    'kb.c',
+    # Configurator M2: dynamic keymap (compiled out unless the board
+    # defines SMK_DYNAMIC_KEYMAP via cc_args).
+    'dynamic_keymap.c',
+    # Configurator M3: USB config protocol (compiled out unless
+    # SMK_CONFIG_PROTOCOL via cc_args).
+    'config_protocol.c',
 ]
 
 possible_src_layout = [
@@ -123,6 +159,8 @@ endif
 
 if get_option('buildtype') == 'debug'
     cc_base_args += '-DDEBUG=1'
+else
+    cc_base_args += '-DDEBUG=0'
 endif
 
 sdar_args = ['-rc']
@@ -130,7 +168,7 @@ sdar_args = ['-rc']
 cc = find_program('sdcc', required : true)
 sdar = find_program('sdar', required : true)
 packihx = find_program('packihx', required : true)
-skbt = find_program('sinowealth-kb-tool', required : true)
+skbt = find_program('sinowealth-kb-tool', required : false)
 
 # Host-side generator that bakes per-device LED animation geometry into ROM tables
 # (see utils/led_geometry_gen.c). Compiled once with the host compiler at configure
@@ -181,6 +219,82 @@ foreach part : parts
             '-DUSB_PID=@0@'.format(options['product_id']),
         ]
 
+        # RK84-specific USB identity + build-mode options. Each is
+        # guarded by has_key() so boards without the option keep the
+        # upstream defaults (defined in src/platform/sh68f90a/usb.h).
+        if options.has_key('usb_bcd_device')
+            cc_args += '-DUSB_BCD_DEVICE=@0@'.format(options['usb_bcd_device'])
+        endif
+        if options.has_key('usb_ep1_mps')
+            cc_args += '-DUSB_EP1_MPS=@0@'.format(options['usb_ep1_mps'])
+        endif
+        if options.has_key('usb_ep2_mps')
+            cc_args += '-DUSB_EP2_MPS=@0@'.format(options['usb_ep2_mps'])
+        endif
+        if options.has_key('usb_serial_index')
+            cc_args += '-DUSB_SERIAL_INDEX=@0@'.format(options['usb_serial_index'])
+        endif
+        if options.has_key('usb_manufacturer')
+            cc_args += '-DUSB_STRING_MANUFACTURER_VALUE=@0@'.format(options['usb_manufacturer'])
+        endif
+        if options.has_key('usb_product')
+            cc_args += '-DUSB_STRING_PRODUCT_VALUE=@0@'.format(options['usb_product'])
+        endif
+        if options.has_key('usb_serial')
+            cc_args += '-DUSB_STRING_SERIAL_VALUE=@0@'.format(options['usb_serial'])
+        endif
+        if options.get('rk84_stock_reports', false)
+            cc_args += '-DRK84_STOCK_REPORTS=1'
+        endif
+        if options.get('rk84_rgb', false)
+            cc_args += '-DRK84_RGB_ENABLE=1'
+        else
+            cc_args += '-DRK84_RGB_ENABLE=0'
+        endif
+        if options.get('rk84_recovery_only', false)
+            cc_args += '-DRK84_RECOVERY_ONLY=1'
+            # Recovery keeps the upstream 1000 ms USB settle (ISP
+            # safety); all other stages boot fast. These MUST be
+            # cc_args, not kbdef.h macros: main.c (framework, shared
+            # by all boards) does not include kbdef.h and selects
+            # boot delay via #ifdef RK84_BOOT_DELAY_MS.
+            cc_args += '-DRK84_BOOT_DELAY_MS=1000'
+            cc_args += '-DRK84_POST_INIT_DELAY_MS=1000'
+        else
+            cc_args += '-DRK84_RECOVERY_ONLY=0'
+            cc_args += '-DRK84_BOOT_DELAY_MS=20'
+            cc_args += '-DRK84_POST_INIT_DELAY_MS=20'
+        endif
+        if options.get('rk84_usb_full', false)
+            cc_args += '-DRK84_USB_FULL=1'
+            cc_args += '-DRK84_USB_HOOKS=1'
+        else
+            cc_args += '-DRK84_USB_FULL=0'
+        endif
+        if options.get('rk84_dual_reports', false)
+            cc_args += '-DRK84_DUAL_REPORTS=1'
+        endif
+        if options.get('rk84_active_keycode_cache', false)
+            cc_args += '-DSMK_ACTIVE_KEYCODE_CACHE=1'
+            # Fn-first: process momentary layer-key transitions before
+            # ordinary keys in the same scan frame (same-frame Fn+media
+            # chords resolve as media, not plain keys).
+            cc_args += '-DSMK_LAYER_KEYS_FIRST=1'
+            # (valid readings are always 0xC0..0xFF). The generic
+            # matrix.c only preserves the previous column for boards
+            # that define this.
+            cc_args += '-DSMK_MATRIX_SAMPLE_INVALID=0x00'
+        endif
+        if options.get('rk84_dynamic_keymap', false) and not options.get('rk84_recovery_only', false)
+            # Configurator M2: runtime-editable keymap (384 B XRAM).
+            # Excluded from recovery: the recovery image stays minimal
+            # (no matrix init, no keymap, no XRAM cost).
+            cc_args += '-DSMK_DYNAMIC_KEYMAP=1'
+            # Configurator M3: USB config protocol (report ID 8).
+            # Requires the dynamic keymap (protocol edits it).
+            cc_args += '-DSMK_CONFIG_PROTOCOL=1'
+        endif
+
         wireless = options.get('wireless', '')
         if wireless == 'bk3632'
             src_main += src_platform_bk3632
@@ -260,10 +374,16 @@ foreach part : parts
         )
 
         flash_target_name = '@0@flash'.format(prefix)
-        run_target(flash_target_name,
-            command : [skbt, 'write', '-d', keyboard, '--force', hex_smk.full_path()], # TODO: try to remove the need for --force
-            depends : hex_smk,
-        )
+        # RK84 has no flash target: the verified recovery workflow is
+        # the sinowisp EP0 tool (see RESCUE.md), not sinowealth-kb-tool.
+        # The flash target also requires sinowealth-kb-tool to be
+        # installed; without it the run target is simply not created.
+        if skbt.found() and keyboard != 'royalkludge-rk84'
+            run_target(flash_target_name,
+                command : [skbt, 'write', '-d', keyboard, '--force', hex_smk.full_path()], # TODO: try to remove the need for --force
+                depends : hex_smk,
+            )
+        endif
 
         message('target available: @0@, flash: @1@'.format(hex_smk_target_name, flash_target_name))
     endforeach
diff --git a/meson.options b/meson.options
index a2af75d..2871edb 100644
--- a/meson.options
+++ b/meson.options
@@ -1 +1,23 @@
 option('nkro', type : 'feature', value : 'enabled', description: 'NKRO support')
+
+option(
+    'rk84_stage',
+    type : 'combo',
+    choices : ['recovery', 'matrix', 'usb', 'rgb'],
+    value : 'recovery',
+    description : 'RK84 bring-up stage: recovery (ISP only), matrix (scan+reports), usb (full wired keyboard), rgb (matrix + static RGB)'
