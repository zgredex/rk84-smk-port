     ['eyooso-z11', 'sh68f90a', ['default'], { 'vendor_id': '0x258a', 'product_id': '0x002a', 'led_rows': '5', 'led_cols': '14', 'led_cx2': '13', 'led_cy2': '4' }],
+    # RK84 (SH68F90A): 16x6 matrix, 21x6 LED grid, wired milestone 1.
+    # Stock USB identity via per-board options; recovery-only + no-RGB
+    # flags make the first flash candidate safe (see RESCUE.md).
+    ['royalkludge-rk84', 'sh68f90a', ['default'], {
+        'vendor_id': '0x258a',
+        'product_id': '0x0059',
+        'led_rows': '6',
+        'led_cols': '21',
+        'led_cx2': '21',
+        'led_cy2': '4',
+        'usb_bcd_device': '0x1025',
+        'usb_ep1_mps': '8',
+        'usb_ep2_mps': '16',
+        'usb_serial_index': '0',
+        'usb_manufacturer': '"SINO WEALTH"',
+        'usb_product': '"RK Bluetooth Keyboar"',
+        'usb_serial': '""',
+        'rk84_stock_reports': true,
+        'rk84_rgb': false,
+        'rk84_recovery_only': true,
